rules_version = '2';
/* КОДЕКС НОЧИ — правила Firestore (с v1.31)
   Своя система логинов без Firebase Auth email/password: анонимная авторизация
   Firebase используется только как «якорь сессии» (request.auth.uid), а сама
   проверка логин/пароль и роли (админ/мастер/игрок) — здесь, в правилах.
   См. §1.3 в комментарии p0_comment.html за подробным описанием модели.
   Вставить целиком: Firebase Console → Firestore Database → вкладка Rules → Publish. */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    /* логин текущей анонимной сессии — по документу sessions/{uid}, который
       создаётся только если пароль совпал (см. правило ниже) */
    function sessionUsername() {
      return exists(/databases/$(database)/documents/sessions/$(request.auth.uid))
        ? get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.username
        : null;
    }

    /* роль всегда читается заново из users/{username} — клиент не может
       «заявить» себе роль, она только выводится из данных */
    function myRole() {
      return sessionUsername() != null && exists(/databases/$(database)/documents/users/$(sessionUsername()))
        ? get(/databases/$(database)/documents/users/$(sessionUsername())).data.role
        : null;
    }

    function isAdmin()  { return myRole() == 'admin'; }
    function isMaster() { return myRole() == 'master' || isAdmin(); }
    function isPlayer() { return myRole() == 'player'; }

    /* переключатель первого запуска: пока документа нет — можно завести
       самого первого админа; как только он создан, лазейка закрывается */
    match /meta/bootstrap {
      allow read: if true;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/meta/bootstrap);
      allow update, delete: if false;
    }

    match /users/{username} {
      /* админ и мастер видят всех (с v1.37 — мастеру нужен список логинов
         игроков для панели «персонажи игроков» в Котерии, см. pcs ниже);
         любой залогиненный — как минимум свою запись (нужно прочитать
         displayName/role сразу после входа) */
      allow read: if isMaster() || sessionUsername() == username;
      /* САМОСТОЯТЕЛЬНАЯ РЕГИСТРАЦИЯ ИГРОКОВ (с v1.38, §1.3.3 в комментарии) —
         третья ветка ниже. Сказано рассказчиком явно: новых игроков больше не
         заводит админ руками, они создают логин/пароль сами на экране входа,
         и это открыто ВСЕМ (без кода-приглашения — тоже явный выбор). Ветка
         пускает создание ТОЛЬКО с role=='player' — 'master'/'admin' по-прежнему
         только через первую ветку (первый бутстрап) или isAdmin() (админ руками
         в #/admin/users): подделать себе роль повыше через devtools нельзя,
         правило проверяет role в САМОЙ отправляемой записи, а не то, что
         показывает клиентская форма. «Логин занят» отдельно не проверяем —
         если документ уже существует, Firestore трактует запись по этому же
         id как update (независимо от того, что вызвал клиент), а update ниже
         требует isAdmin() — то есть попытка занятым логином сама получит
         permission-denied, ровно то, что нужно. */
      allow create: if signedIn() && (
        (!exists(/databases/$(database)/documents/meta/bootstrap) && request.resource.data.role == 'admin')
        || isAdmin()
        || request.resource.data.role == 'player'
      );
      allow update, delete: if isAdmin();
    }

    match /sessions/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      /* создать сессию можно только если presetHash совпал с уже сохранённым
         хэшем пароля — само сравнение делает движок правил, а не клиент */
      allow create: if signedIn() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.username))
        && request.resource.data.passwordHash ==
             get(/databases/$(database)/documents/users/$(request.resource.data.username)).data.passwordHash;
      allow update: if false;
    }

    /* ЖИВЫЕ ЛИСТЫ ПЕРСОНАЖЕЙ (с v1.35, §1.2/§1.3.1 в комментарии) — track
       (голод/здоровье/воля/человечность) персонажа игрока, документ на
       каждого: pcstate/{id персонажа, как в PCS в данных}.
       НЕ ставим здесь reason read/write по owner-полю самого документа —
       клиент мог бы тогда просто вписать в запись «owner: себя» и захватить
       чужой лист, ведь привязка «кто реально владеет каким PC» хранится в
       данных страницы (PCS[].owner), а не в самом Firestore, и правила
       не могут туда заглянуть. Вместо этого — по модели доверия всего
       проекта (см. §1.3: некрашированные пароли, закрытая группа): читать
       может любой залогиненный (листы персонажей и так публично видны в
       приложении всем ролям — тумана войны ещё нет, см. §1.2), править —
       мастер/админ или любой игрок; кто из игроков реально видит кнопки
       редактирования чужого листа — решает клиент (p3g_pcsync.js), не
       правила. Раскрывать это дальше (настоящая проверка владения) есть
       смысл только вместе с «туманом войны» из §1.2 — тогда появится
       причина хранить owner и в Firestore, а не только в данных. */
    match /pcstate/{pcId} {
      allow read: if signedIn();
      allow write: if isMaster() || isPlayer();
    }

    /* САМОСТОЯТЕЛЬНЫЕ ЧАРНИКИ ИГРОКОВ (с v1.37, §1.3.2 в комментарии) —
       игрок/мастер заводит персонажа сам во вкладке Котерия, вся анкета
       (не только track, как в pcstate выше) целиком в этом документе.
       В отличие от pcstate, owner здесь — ЧАСТЬ САМОГО ДОКУМЕНТА и
       назначается правилом create (request.resource.data.owner ==
       sessionUsername()), а не берётся на веру с клиента задним числом —
       значит проверка владения ниже настоящая, подделать чужой owner
       нельзя (в этом разница с предупреждением про pcstate выше).
       ВИДИМОСТЬ (сказано рассказчиком, v1.37): владелец — всегда; мастер
       и админ — тоже видят все документы (isMaster() уже включает
       isAdmin(), см. myRole() выше), это и даёт мастеру панель «персонажи
       игроков» и админу — список всех чарников без выбора. Другие игроки
       чужие документы не видят вообще — им правило read не даёт их даже
       прочитать, не то что увидеть в списке.
       ПРАВКА: только owner, БЕЗ исключения для мастера/админа — они могут
       смотреть чужой лист, но не менять его. Это нарочно отличается от
       pcstate (там мастер/админ правят любой живой лист статичных PCS[]). */
    match /pcs/{pcId} {
      allow read: if isMaster() || (signedIn() && resource.data.owner == sessionUsername());
      allow create: if signedIn() && request.resource.data.owner == sessionUsername();
      allow update: if signedIn() && resource.data.owner == sessionUsername()
        && request.resource.data.owner == resource.data.owner;
      allow delete: if signedIn() && resource.data.owner == sessionUsername();
    }

    /* ЗАГОТОВКА НА БУДУЩЕЕ (roadmap §1.2 в комментарии) — сюда позже добавятся
       правила для лога бросков, даунтайма, XP, шёпотов, тумана войны и т.д.
       Общий паттерн для новой коллекции "foo" с настоящей владельческой
       привязкой (owner — часть самого документа, как у pcs выше, а не
       заготовка на будущее — теперь это реализованный, а не гипотетический
       пример; НЕ переиспользовать паттерн pcstate выше для новых коллекций):
         allow read:  if isMaster() || (signedIn() && resource.data.owner == sessionUsername());
         allow write: if isMaster() || (signedIn() && request.resource.data.owner == sessionUsername());
       — мастер видит/пишет всё, игрок только свои документы (owner-поле). */
  }
}
